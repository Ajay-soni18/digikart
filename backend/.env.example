# Digikart — backend environment template.
# Copy to `.env` (dev) or set these as real environment variables (prod).

# Which settings module to load: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# True for local dev, False in production
DEBUG=True

# Comma-separated hostnames Django will serve (prod, e.g. api.digikart.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Unset -> local SQLite. In prod set a Postgres DSN:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Cache. Unset -> in-memory. In prod use Redis:
# REDIS_URL=redis://HOST:6379/0
REDIS_URL=

# Comma-separated frontend origins allowed to call the API (prod):
# CORS_ALLOWED_ORIGINS=https://digikart.com,https://www.digikart.com
CORS_ALLOWED_ORIGINS=

# --- Google OAuth (REQUIRED — the only signup/login method) --------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client
# ID -> "Web application". Add your frontend origins to "Authorized JavaScript
# origins" (e.g. http://localhost:5173 and your prod domain). Copy the "Client
# ID" (ends in .apps.googleusercontent.com) here. The SAME value goes in the
# frontend as VITE_GOOGLE_CLIENT_ID. The backend verifies every Google ID token
# against this id, so it must match the frontend's client id exactly.
GOOGLE_OAUTH_CLIENT_ID=

# Razorpay — use TEST keys in dev, LIVE keys in prod
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Dashboard → Settings → Webhooks). Distinct from the
# key secret above. Set this to enable POST /api/v1/payments/webhook/.
RAZORPAY_WEBHOOK_SECRET=

# YouTube Data API v3 key — enables the admin "Import from YouTube playlist"
# feature. Leave blank to disable it (single-lecture add still works).
YOUTUBE_API_KEY=

# --- Cloud storage: Cloudflare R2 (S3-compatible, PRIVATE bucket) --------------
# Used by config.settings.prod when CLOUDFLARE_R2_BUCKET_NAME is set. Leave
# blank in local dev to keep uploads on the local filesystem.
# Full click-by-click instructions: see CLOUDFLARE_R2_SETUP.md at the repo root.
#
# Where each value comes from in the Cloudflare dashboard:
#   1. R2 Object Storage -> Overview: your 32-hex-char Account ID is shown on
#      the right (also in the dashboard URL) -> CLOUDFLARE_R2_ACCOUNT_ID
#   2. Create bucket (keep it private — never enable Public Access / r2.dev)
#      -> CLOUDFLARE_R2_BUCKET_NAME
#   3. R2 -> API -> Manage API tokens -> Create API token ->
#      permission "Object Read & Write", scoped to that one bucket. It shows
#      the S3 credentials ONCE:
#        Access Key ID     -> CLOUDFLARE_R2_ACCESS_KEY_ID
#        Secret Access Key -> CLOUDFLARE_R2_SECRET_ACCESS_KEY
#   4. Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#      (derived automatically from the account id when left blank)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_REGION=auto

# How long a presigned note-file URL stays valid, in seconds. The viewer
# refreshes it transparently before expiry; keep it short (default 60).
SIGNED_URL_EXPIRY_SECONDS=60
