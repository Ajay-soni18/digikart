# Digikart — frontend environment template.
# Copy to `.env` (or `.env.local`) for local development.

# Base URL of the Django API (no trailing slash). The API client appends
# the versioned path, e.g. `${VITE_API_BASE_URL}/api/v1/...`.
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth client id (REQUIRED — the only sign-in method). Get it from
# Google Cloud Console -> Credentials -> OAuth client ID (Web application), and
# add your frontend origins (e.g. http://localhost:5173) to "Authorized
# JavaScript origins". It's public/safe to ship to the browser. MUST be the
# same value as the backend's GOOGLE_OAUTH_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Razorpay public key id (TEST key in dev). Safe to expose to the browser.
VITE_RAZORPAY_KEY_ID=
